{
  "_formatVersion": "1.0.0",
  "workflow": {
    "name": "<kebab-case-name>",
    "definition": {
      "name": "<kebab-case-name>",
      "priority": 5,
      "timeoutMs": 1800000,
      "statusUpdateMethod": "comment",
      "triggers": [
        {
          "event": "manual",
          "slashCommand": { "command": "<kebab-case-name>", "requireMention": false }
        }
      ],
      "steps": [
        {
          "id": "clone",
          "name": "Clone repository",
          "action": "git.clone",
          "params": { "repoFullName": "{{trigger.repository.fullName}}", "cloneOptions": { "depth": 1 } },
          "stepMaxDurationMinutes": 10
        },
        {
          "id": "step-1",
          "name": "<step name>",
          "action": "agent.run",
          "instruction": "<what this agent should do, framework-free>",
          "params": { "agentId": "<agent-name>-agent-id" },
          "stepMaxDurationMinutes": 20
        }
      ],
      "flow": [
        { "from": "", "to": "clone" },
        { "from": "clone", "to": "step-1" }
      ]
    }
  },
  "refs": {
    "agents": [
      { "id": "<agent-name>-agent-id", "name": "<agent-name>" }
    ]
  }
}
